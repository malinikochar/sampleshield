# Supabase project settings: dashboard > Project Settings > API
# Public and safe to include in browser when RLS is correctly configured.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Do not put service role/secret keys here unless a strictly necessary server-only
# operation is designed and secured. NEVER prefix a secret with NEXT_PUBLIC_.

# Optional deployment environment setting; do not use as authorization mechanism.
NEXT_PUBLIC_APP_ENV=development
